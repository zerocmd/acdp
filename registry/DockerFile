FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 5000

# One worker process: agents, shared memory and chat history live in process memory,
# so a second worker would be a second, divergent registry. Threads give concurrency.
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--timeout", "240", "--workers", "1", "--threads", "8", "--log-level", "info", "app:app"]
